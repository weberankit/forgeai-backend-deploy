# Select openai or mistral. Models for every task and quality mode are defined
# centrally in config/llmProfiles.js.
LLM_PROVIDER=openai
# Optional custom/proxy endpoint. Leave empty to automatically use the selected
# provider's official base URL.
LLM_BASE_URL=

# Browser session keys remain supported and take precedence. For local testing
# with a server-side key, explicitly enable this opt-in and store the secret in
# your deployment secret manager. Never commit a real key.
ALLOW_SERVER_LLM_KEY=false
LLM_API_KEY=
# Provider-specific alternatives when LLM_API_KEY is empty:
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional when Chromium is installed by the runtime host.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional Bright Data Browser API endpoint. When configured, all rendered
# browser discovery, thumbnails, and selected-page captures use remote Chrome.
# Store the real credential in the deployment secret manager, never in source.
BRIGHT_DATA_BROWSER_WS_ENDPOINT=wss://BRIGHT_DATA_USERNAME:BRIGHT_DATA_PASSWORD@brd.superproxy.io:9222

# Maximum preview pages and maximum selectable pages (clamped to 1-12).
WEBSITE_IMPORT_MAX_PAGES=5

# Optional Langfuse observability. LLM prompts and outputs are included in traces.
# API keys are never added. Immediate export makes completed calls visible quickly.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Generation reliability. Sequential execution is the safe default because each
# batch consumes the last validated checkpoint. Increase only for disjoint files.
GENERATION_PARALLELISM=1
GENERATION_PREVIOUS_CONTEXT_CHARS=10000
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_EXPORT_MODE=immediate
# Optional deployment/version identifier, such as a Git commit SHA.
LANGFUSE_RELEASE=
