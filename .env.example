# OpenAI credentials are supplied per request by the frontend.
# Do not configure a shared server API key.
LLM_BASE_URL=https://api.openai.com/v1

# Each task has its own profile. These override config/llmProfiles.js.
LLM_EXPANSION_PROVIDER=openai
LLM_EXPANSION_MODEL=gpt-4.1-mini
LLM_EXPANSION_TEMPERATURE=0.2

LLM_PLANNING_PROVIDER=openai
LLM_PLANNING_MODEL=gpt-4.1-mini
LLM_PLANNING_TEMPERATURE=0.15

LLM_CODE_GENERATION_PROVIDER=openai
LLM_CODE_GENERATION_MODEL=gpt-4.1-mini
LLM_CODE_GENERATION_TEMPERATURE=0.1

LLM_GENERATION_REPAIR_PROVIDER=openai
LLM_GENERATION_REPAIR_MODEL=gpt-4.1-mini
LLM_GENERATION_REPAIR_TEMPERATURE=0.05

LLM_EDIT_PROVIDER=openai
LLM_EDIT_MODEL=gpt-4.1-mini
LLM_EDIT_TEMPERATURE=0.1

LLM_EXPLAIN_PROVIDER=openai
LLM_EXPLAIN_MODEL=gpt-4.1-mini
LLM_EXPLAIN_TEMPERATURE=0.3

LLM_VISION_PROVIDER=openai
LLM_VISION_MODEL=gpt-4.1-mini
LLM_VISION_TEMPERATURE=0.2

LLM_INTENT_PROVIDER=openai
LLM_INTENT_MODEL=gpt-4.1-mini
LLM_INTENT_TEMPERATURE=0

# Any task also supports: *_MAX_OUTPUT_TOKENS, *_TIMEOUT_MS, *_MAX_RETRIES, *_BASE_URL

# Optional when Chromium is installed by the runtime host.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional Bright Data Browser API endpoint. When configured, all rendered
# browser discovery, thumbnails, and selected-page captures use remote Chrome.
# Store the real credential in the deployment secret manager, never in source.
BRIGHT_DATA_BROWSER_WS_ENDPOINT=wss://BRIGHT_DATA_USERNAME:BRIGHT_DATA_PASSWORD@brd.superproxy.io:9222

# Maximum preview pages and maximum selectable pages (clamped to 1-12).
WEBSITE_IMPORT_MAX_PAGES=5

# Optional Langfuse observability. LLM prompts and outputs are included in traces.
# API keys are never added. Immediate export makes completed calls visible quickly.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_EXPORT_MODE=immediate
# Optional deployment/version identifier, such as a Git commit SHA.
LANGFUSE_RELEASE=
