# Provider switching is environment-only. Task and phase model names are kept in
# config/llmProfiles.js under PROVIDER_LLM_QUALITY_PROFILES.

# OpenAI
LLM_PROVIDER=openai

# Mistral alternative
# LLM_PROVIDER=mistral

# Optional custom/proxy endpoint. Leave empty for the selected provider's
# automatic official base URL.
LLM_BASE_URL=

# Optional local/server-key mode. Browser session keys take precedence.
ALLOW_SERVER_LLM_KEY=false
LLM_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
